{
  "expo": {
    "owner": "book-scrubby",
    "name": "Tidyups Cleaning",
    "slug": "tidyups-cleaning",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tidyups",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0611",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tidyups.cleaning",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tidyups.cleaning",
      "adaptiveIcon": {
        "backgroundColor": "#0A0611",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0611",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tidyups uses your location to share your live position with dispatch while you head to a job site."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B2FC9"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97c4d8ba-f6c2-48f8-8bcc-a2021d662d76"
      }
    }
  }
}
