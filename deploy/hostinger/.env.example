# Required
MONGO_URL=mongodb://mongo:27017
DB_NAME=tidyups
ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ORIGINS=https://tidyupsbooking.com,https://www.tidyupsbooking.com

# Keep Hostinger uploads on the VPS, independent from Emergent.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data/storage

# Optional Twilio notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LEAD_ALERT_TO=

# Optional Google Sheets integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
