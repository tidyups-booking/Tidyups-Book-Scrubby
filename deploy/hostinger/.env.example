# Optional Google Sheets integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional synchronization with an existing production API
PRODUCTION_API_URL=
PRODUCTION_ADMIN_PASSWORD=
